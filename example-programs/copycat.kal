#memalias $string $0
#memalias $welcome_string $100
#datafrom $welcome_string "Type something: "

start:
	; Print welcome string.
	mv %0 &welcome_string
	call .print_string

	mv %0 &string

	typing_loop:
		getc %1
		jmpz %1 .typing_loop ; Ignore when no key is being pressed.
		outa %1 ; Echo typed character.

		; Store typed character in string and increment pointer.
		mv *0 %1
		inc %0

		; If typed character was LF, exit loop.
		sub %1 10
		jmpz %1 .done_typing
		jmp .typing_loop

	done_typing:
	; Add null-termination and reset pointer to beginning of string, then print.
	mv *0 0
	mv %0 &string
	call .print_string
	hlt

print_string:
	; Print character under pointer until null is reached.
	outa *0
	inc %0
	jmpz *0 .print_string_ret
	jmp .print_string

	print_string_ret:
	ret